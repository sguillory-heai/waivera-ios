<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>chat.list.title.group</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$@ &amp; %2$#@others@</string>
        <key>others</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>%ld other</string>
            <key>other</key>
            <string>%ld others</string>
        </dict>
    </dict>
    <key>chat.list.title.countCompact</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@others@</string>
        <key>others</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>+%ld</string>
            <key>other</key>
            <string>+%ld</string>
        </dict>
    </dict>
    <key>chat.list.time.minutes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@minutes@</string>
        <key>minutes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>other</key>
            <string>%ldm</string>
        </dict>
    </dict>
    <key>chat.list.unread</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>%ld unread message</string>
            <key>other</key>
            <string>%ld unread messages</string>
        </dict>
    </dict>
    <key>chat.new.selected</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>other</key>
            <string>%ld selected</string>
        </dict>
    </dict>
</dict>
</plist>
